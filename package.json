{
  "name": "mealie-mcp",
  "version": "0.2.0",
  "description": "Remote MCP server that lets AI apps work with your self-hosted Mealie as you.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greirson/mealie-mcp.git"
  },
  "homepage": "https://github.com/greirson/mealie-mcp#readme",
  "keywords": [
    "mcp",
    "mealie",
    "claude",
    "chatgpt",
    "cursor",
    "oauth",
    "model-context-protocol",
    "self-hosted"
  ],
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "MEALIE_TEST_LIVE=1 vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "live:up": "docker compose -f docker-compose.test.yml up -d --build",
    "live:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.1",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "msw": "^2.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
